<div class="w-screen min-h-screen bg-black text-white">

  <div class="w-screen min-h-screen px-10 py-8">

    <div class="
      flex
      items-center
      justify-between
      mb-14
      sticky
      top-0
      bg-black/80
      backdrop-blur-xl
      z-50
      py-4
    ">

      <a
        href="/?day=<%= @previous_day %>"
        class="
          w-16
          h-16
          flex
          items-center
          justify-center
          rounded-full
          bg-zinc-900
          border
          border-zinc-800
          text-3xl
          hover:bg-zinc-800
          transition
          shadow-2xl
        "
      >
        ←
      </a>

      <a href="/" class="text-center">

        <p class="
          text-zinc-500
          text-sm
          uppercase
          tracking-[0.4em]
        ">
          Rastreador de treino
        </p>

        <h1 class="
          text-6xl
          font-black
          mt-2
          tracking-tight
          hover:opacity-80
          transition
        ">

          <% if @workout_day&.name == @today_name %>
            Treino de Hoje
          <% else %>
            Treino de <%= @workout_day&.name %>
          <% end %>

        </h1>

        <% if @workout_day %>
          <p class="
            text-zinc-500
            mt-3
            text-xl
            font-medium
          ">
            <%= @workout_day.name %>
          </p>
        <% end %>

      </a>

      <a
        href="/?day=<%= @next_day %>"
        class="
          w-16
          h-16
          flex
          items-center
          justify-center
          rounded-full
          bg-zinc-900
          border
          border-zinc-800
          text-3xl
          hover:bg-zinc-800
          transition
          shadow-2xl
        "
      >
        →
      </a>

    </div>

    <div class="flex justify-center mb-12">

      <a
        href="<%= new_exercise_path %>"
        class="
          bg-white
          text-black
          px-8
          py-4
          rounded-3xl
          font-black
          text-lg
          hover:scale-[1.03]
          transition
          shadow-2xl
        "
      >
        + Novo Exercício
      </a>

    </div>

    <% if @exercises.any? %>

      <div class="
        grid
        grid-cols-1
        md:grid-cols-2
        xl:grid-cols-3
        2xl:grid-cols-4
        gap-8
      ">

        <% @exercises.each do |exercise| %>

          <div class="
            bg-zinc-950
            border
            border-zinc-800
            rounded-[2rem]
            p-7
            shadow-2xl
            hover:border-zinc-700
            hover:-translate-y-2
            transition
            duration-300
          ">

            <div class="flex items-start justify-between">

              <div>

                <h2 class="
                  text-3xl
                  font-black
                  leading-tight
                ">
                  <%= exercise.name %>
                </h2>

                <p class="
                  text-zinc-500
                  mt-3
                  text-lg
                ">
                  <%= exercise.muscle %>
                </p>

              </div>

              <span class="
                px-4
                py-2
                rounded-full
                text-sm
                font-black
                bg-white
                text-black
                whitespace-nowrap
              ">
                <%= exercise.difficulty %>
              </span>

            </div>

            <div class="
              mt-8
              bg-zinc-900
              border
              border-zinc-800
              rounded-3xl
              p-5
            ">

              <p class="
                text-zinc-500
                text-sm
                uppercase
                tracking-widest
              ">
                Equipamento
              </p>

              <p class="
                text-xl
                font-semibold
                mt-2
              ">
                <%= exercise.equipment %>
              </p>

            </div>

            <div class="flex gap-4 mt-8">

                <a
                  href="<%= exercise.video_url %>"
                  target="_blank"
                  class="
                    flex-1
                    text-center
                    bg-white
                    text-black
                    py-4
                    rounded-2xl
                    font-black
                    hover:opacity-80
                    transition
                  "
                >
                  Ver exercício
                </a>

                <%= turbo_frame_tag dom_id(exercise, :completion) do %>

                  <%= button_to toggle_completion_exercise_path(exercise),
                    method: :post,
                    class: "
                      w-16
                      rounded-2xl
                      bg-zinc-900
                      border
                      border-zinc-800
                      hover:bg-zinc-800
                      transition
                      text-2xl
                    " do %>

                    <%= exercise.completed_today? ? "✓" : "X" %>

                  <% end %>

                <% end %>

              </div>

          </div>

        <% end %>

      </div>

    <% else %>

      <div class="
        bg-zinc-950
        border
        border-zinc-800
        rounded-[2rem]
        p-16
        text-center
        shadow-2xl
      ">

        <p class="
          text-zinc-500
          text-2xl
        ">
          Nenhum treino encontrado para hoje.
        </p>

      </div>

    <% end %>

  </div>

</div>